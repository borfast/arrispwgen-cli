{
    "name": "@borfast/arrispwgen-cli",
    "version": "6.0.0",
    "description": "Arris Password of the Day Generator Command Line Interface",
    "keywords": [
        "arris",
        "arrispwd",
        "arrispwgen",
        "password-of-the-day",
        "password of the day"
    ],
    "homepage": "https://arrispwgen.borfast.com",
    "bugs": {
        "url": "https://github.com/borfast/arrispwgen-cli/issues"
    },
    "license": "MIT",
    "author": "Raúl Santos (https://www.borfast.com)",
    "type": "module",
    "files": [
        "dist"
    ],
    "bin": {
        "arrispwgen": "./dist/cli.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/borfast/arrispwgen-cli.git"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "prepublishOnly": "npm run build",
        "lint": "biome check .",
        "format": "biome check --write .",
        "typecheck": "tsc --noEmit",
        "pretest": "npm run lint && npm run typecheck && npm run build",
        "test": "vitest run"
    },
    "dependencies": {
        "@borfast/arrispwgen": "^6.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "@types/node": "^26.1.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=24.18.0"
    }
}
